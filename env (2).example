# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ^ Service role key bypasses RLS - keep this ONLY on the server, never in frontend code

# Razorpay Dashboard -> Settings -> API Keys (test mode is free, supports UPI)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Platform's commission cut per booking. Owner receives (100 - this)%.
PLATFORM_COMMISSION_PERCENT=15

PORT=5000
CLIENT_URL=http://localhost:5173
